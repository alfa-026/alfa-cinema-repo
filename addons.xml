<?xml version='1.0' encoding='UTF-8'?>
<addons>
  <addon id="plugin.video.alfa.cinema" name="ALFA CINEMA" version="1.2.4" provider-name="ALFA CINEMA">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
      <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="es_ES">Centro multimedia personal para Kodi</summary>
      <description lang="es_ES">ALFA CINEMA multiplataforma para Kodi con catálogo TMDB, fuentes abiertas y biblioteca Trakt. Incluye diagnóstico de importaciones y ejecución. No incorpora binarios nativos ni dependencias Python externas.</description>
      <platform>all</platform>
      <license>MIT</license>
      <assets>
        <icon>icon.png</icon>
      </assets>
    </extension>
  </addon>
  <addon id="repository.alfa.cinema" name="ALFA CINEMA Repository" version="1.0.0" provider-name="ALFA CINEMA">
    <extension point="xbmc.addon.repository" name="ALFA CINEMA Repository">
      <dir>
        <info>https://alfa-026.github.io/alfa-cinema-repo/addons.xml</info>
        <checksum>https://alfa-026.github.io/alfa-cinema-repo/addons.xml.md5</checksum>
        <datadir zip="true">https://alfa-026.github.io/alfa-cinema-repo/</datadir>
        <hashes>false</hashes>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="es_ES">Repositorio oficial de ALFA CINEMA</summary>
      <description lang="es_ES">Repositorio de distribución de ALFA CINEMA alojado en GitHub Pages.</description>
      <platform>all</platform>
      <license>MIT</license>
    </extension>
  </addon>
</addons>